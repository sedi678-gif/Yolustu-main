        && d.battleId == battleId
        && d.playerId is string
        && officialCardCost(d.cardId) > 0
        && d.cost == officialCardCost(d.cardId)
        && d.energyBefore is int
        && d.energyAfter is int
        && d.energyAfter == d.energyBefore - d.cost
        && d.energyAfter >= 0
        && d.energyBefore <= 25
        && d.energyBefore >= d.cost
        && d.usageAfter is int
        && d.usageAfter > 0
        && d.usageAfter <= 3
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.side in ['attacker', 'defender']
        && (
          (d.side == 'attacker' && d.playerId in battleData(battleId).attackerPlayerIds)
          || (d.side == 'defender' && d.playerId in battleData(battleId).defenderPlayerIds)
        )
        && officialDamage(d.cardId) >= 0
        && d.damage == officialDamage(d.cardId)
        && d.playerDelta == officialPlayerDelta(d.cardId)
        && d.allianceDelta == officialAllianceDelta(d.cardId)
        && d.steal == officialSteal(d.cardId)
        && d.clickRequired == officialChallengeClicks(d.cardId, d.targetAllianceId)
        && (
          d.clickRequired == 0
          || (
            d.cardId == 'usyan'
            && (
              (d.side == 'attacker' && d.targetAllianceId == battleData(battleId).attackerAllianceId)
              || (d.side == 'defender' && d.targetAllianceId == battleData(battleId).defenderAllianceId)
            )
          )
          || (
            d.cardId != 'usyan'
            && (
              (d.side == 'attacker' && d.targetAllianceId == battleData(battleId).defenderAllianceId)
              || (d.side == 'defender' && d.targetAllianceId == battleData(battleId).attackerAllianceId)
            )
          )
        )
        && d.clickRequired is int
        && d.clickRequired >= 0
        && d.clickRequired <= 14
        && (d.challengeId == null || d.challengeId == d.requestId)
        && (d.clickRequired == 0 || d.challengeId == d.requestId)
        && d.effectKinds is list
        && d.effectKinds.size() > 0
        && d.effectKinds.size() <= 6
        && d.damage is int
        && d.playerDelta is int
        && d.allianceDelta is int
        && d.steal is int
        && d.taken is int
        && d.damage >= 0
        && d.damage <= 12
        && d.playerDelta >= 0
        && d.playerDelta <= 10
        && d.allianceDelta >= 0
        && d.allianceDelta <= 8
        && d.steal >= 0
        && d.steal <= 6
        && d.taken >= 0
        && d.taken <= d.steal
        && d.playerScoreAfter is int
        && d.attackerScoreAfter is int
        && d.defenderScoreAfter is int
        && d.ownAllianceAfter is int
        && d.oppAllianceAfter is int
        && (
          (
            exists(/databases/$(database)/documents/battles/$(battleId)/scores/$(d.playerId))
            && d.playerScoreAfter == get(/databases/$(database)/documents/battles/$(battleId)/scores/$(d.playerId)).data.score + d.playerDelta
          ) || (
            !exists(/databases/$(database)/documents/battles/$(battleId)/scores/$(d.playerId))
            && d.playerScoreAfter == d.playerDelta
          )
        )
        && d.playerScoreAfter >= d.playerDelta
        && d.playerScoreAfter <= 1000000
        && d.attackerScoreAfter >= 0
        && d.defenderScoreAfter >= 0
        && d.attackerScoreAfter <= 1000000
        && d.defenderScoreAfter <= 1000000
        && d.taken == (d.steal < opp0 ? d.steal : opp0)
        && d.ownAllianceAfter == own0 + d.allianceDelta + d.taken
        && d.oppAllianceAfter == opp0 - d.taken
        && d.ownAllianceAfter == (d.side == 'attacker' ? d.attackerScoreAfter : d.defenderScoreAfter)
        && d.oppAllianceAfter == (d.side == 'attacker' ? d.defenderScoreAfter : d.attackerScoreAfter)
        && d.eventSeq == battleData(battleId).eventSeq + 6
        && d.keys().hasOnly([
          'requestId', 'battleId', 'playerId', 'cardId', 'side', 'cost',
          'energyBefore', 'energyAfter', 'usageAfter', 'cooldownUntil',
          'eventSeq', 'stateVersion', 'turn', 'turnSide', 'turnPlayerId',
          'damage', 'playerDelta', 'allianceDelta', 'steal', 'taken',
          'playerScoreAfter', 'attackerScoreAfter', 'defenderScoreAfter',
          'ownAllianceAfter', 'oppAllianceAfter',
          'effectKinds', 'clickRequired', 'targetAllianceId', 'challengeId',
          'schemaVersion', 'createdAt'
        ]);
