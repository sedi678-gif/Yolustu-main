rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isProtectedPath(path) {
      return path.size() > 0 && (
        path[0] == 'battles' ||
        path[0] == 'alliance_battle_cooldowns' ||
        path[0] == 'battle_card_costs' ||
        path[0] == 'server_clock' ||
        path[0] == 'leaderboard_daily' ||
        path[0] == 'leaderboard_weekly' ||
        path[0] == 'leaderboard_state' ||
        path[0] == 'leaderboard_resets' ||
        path[0] == 'leaderboard_archives' ||
        path[0] == 'leaderboard_awards' ||
        path[0] == 'alliances'
      );
    }

    function isAllianceMemberOrLeader(allianceId, playerId) {
      return allianceId is string
        && playerId is string
        && exists(/databases/$(database)/documents/alliances/$(allianceId))
        && (
          get(/databases/$(database)/documents/alliances/$(allianceId)).data.leaderId == playerId
          || (
            get(/databases/$(database)/documents/alliances/$(allianceId)).data.keys().hasAny(['members'])
            && get(/databases/$(database)/documents/alliances/$(allianceId)).data.members is list
            && playerId in get(/databases/$(database)/documents/alliances/$(allianceId)).data.members
          )
        );
    }

    function playerBelongsToAlliance(playerId, allianceId) {
      return exists(/databases/$(database)/documents/players/$(playerId))
        && get(/databases/$(database)/documents/players/$(playerId)).data.allianceId == allianceId
        && isAllianceMemberOrLeader(allianceId, playerId);
    }

    function sidePlayersBelong(ids, allianceId) {
      return ids is list
        && (
          ids.size() == 0
          || (
            playerBelongsToAlliance(ids[0], allianceId)
            && (ids.size() < 2 || playerBelongsToAlliance(ids[1], allianceId))
            && (ids.size() < 3 || playerBelongsToAlliance(ids[2], allianceId))
            && (ids.size() < 4 || playerBelongsToAlliance(ids[3], allianceId))
            && (ids.size() < 5 || playerBelongsToAlliance(ids[4], allianceId))
          )
        );
    }

    function isBattleEventType(t) {
      return t in [
        'battle_created',
        'player_joined',
        'player_left',
        'loadout_locked',
        'card_played',
        'energy_changed',
        'card_blocked',
        'card_countered',
        'click_started',
        'click_completed',
        'damage_applied',
        'score_changed',
        'turn_started',
        'turn_timeout',
        'battle_finished'
      ];
    }

    function isValidOpenBattleCreate() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'createdBy',
          'createdAt',
          'updatedAt',
          'status',
          'eventSeq',
          'participantIds',
          'schemaVersion',
          'attackerScore',
          'defenderScore',
          'scoreVersion',
          'lastScoreRequestId'
        ])
        && d.createdBy is string
        && d.createdBy.size() > 0
        && d.createdBy.size() < 64
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.status == 'open'
        && d.eventSeq == 1
        && d.participantIds is list
        && d.participantIds.size() == 1
        && d.schemaVersion == 1
        && d.attackerScore == 0
        && d.defenderScore == 0
        && d.scoreVersion == 0
        && d.lastScoreRequestId == null;
    }

    function isValidMapBattleCreate() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'createdBy',
          'createdAt',
          'updatedAt',
          'status',
          'eventSeq',
          'participantIds',
          'schemaVersion',
          'kind',
          'attackerAllianceId',
          'defenderAllianceId',
          'attackerAllianceName',
          'defenderAllianceName',
          'attackerPlayerIds',
          'defenderPlayerIds',
          'attackerUids',
          'defenderUids',
          'joinDurationMs',
          'attackerScore',
          'defenderScore',
          'scoreVersion',
          'lastScoreRequestId'
        ])
        && d.createdBy is string
        && d.createdBy.size() > 0
        && d.createdBy.size() < 64
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.status == 'joining'
        && d.kind == 'alliance_map'
        && d.eventSeq == 1
        && d.schemaVersion == 1
        && d.joinDurationMs == 15000
        && d.attackerAllianceId is string
        && d.defenderAllianceId is string
        && d.attackerAllianceId != d.defenderAllianceId
        && d.attackerPlayerIds is list
        && d.attackerPlayerIds.size() == 1
        && d.defenderPlayerIds is list
        && d.defenderPlayerIds.size() == 0
        && d.attackerUids is list
        && d.attackerUids.size() == 1
        && d.attackerUids[0] == request.auth.uid
        && d.defenderUids is list
        && d.defenderUids.size() == 0
        && d.participantIds == d.attackerPlayerIds
        && d.attackerScore == 0
        && d.defenderScore == 0
        && d.scoreVersion == 0
        && d.lastScoreRequestId == null
        && exists(/databases/$(database)/documents/alliances/$(d.defenderAllianceId))
        && exists(/databases/$(database)/documents/alliances/$(d.attackerAllianceId))
        && d.createdBy == d.attackerPlayerIds[0]
        && playerBelongsToAlliance(d.createdBy, d.attackerAllianceId);
    }

    function isValidLegacySeqBump() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && after.eventSeq == before.eventSeq + 1
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.schemaVersion == before.schemaVersion
        && after.diff(before).affectedKeys()
          .hasOnly(['eventSeq', 'updatedAt'])
        && after.status == before.status
        && after.status in ['open', 'joining', 'locked', 'active']
        && after.participantIds == before.participantIds
        && after.updatedAt == request.time;
    }

    function isValidMapBattleJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.kind == 'alliance_map'
        && before.status in ['joining', 'locked', 'active']
        && after.status == before.status
        && (
          before.status != 'joining'
          || request.time < before.createdAt + duration.value(15, 's')
        )
        && after.eventSeq == before.eventSeq + 1
        && after.createdAt == before.createdAt
        && after.joinDurationMs == before.joinDurationMs
        && after.attackerAllianceId == before.attackerAllianceId
        && after.defenderAllianceId == before.defenderAllianceId
        && after.attackerPlayerIds is list
        && after.defenderPlayerIds is list
        && after.attackerPlayerIds.size() <= 5
        && after.defenderPlayerIds.size() <= 5
        && after.attackerPlayerIds.size() >= before.attackerPlayerIds.size()
        && after.defenderPlayerIds.size() >= before.defenderPlayerIds.size()
        && after.attackerPlayerIds.size() + after.defenderPlayerIds.size()
          == before.attackerPlayerIds.size() + before.defenderPlayerIds.size() + 1
        && after.attackerUids is list
        && after.defenderUids is list
        && after.attackerUids.size() == after.attackerPlayerIds.size()
        && after.defenderUids.size() == after.defenderPlayerIds.size()
        && after.attackerUids.size() + after.defenderUids.size()
          == before.attackerUids.size() + before.defenderUids.size() + 1
        && (
          (
            after.attackerPlayerIds.size() == before.attackerPlayerIds.size() + 1
            && after.defenderUids == before.defenderUids
            && request.auth.uid in after.attackerUids
          ) || (
            after.defenderPlayerIds.size() == before.defenderPlayerIds.size() + 1
            && after.attackerUids == before.attackerUids
            && request.auth.uid in after.defenderUids
          )
        )
        && after.diff(before).affectedKeys()
          .hasOnly([
            'eventSeq',
            'updatedAt',
            'participantIds',
            'attackerPlayerIds',
            'defenderPlayerIds',
            'attackerUids',
            'defenderUids'
          ])
        && sidePlayersBelong(after.attackerPlayerIds, after.attackerAllianceId)
        && sidePlayersBelong(after.defenderPlayerIds, after.defenderAllianceId)
        && after.updatedAt == request.time;
    }

    function isValidMapBattleLock() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.kind == 'alliance_map'
        && before.status == 'joining'
        && request.time >= before.createdAt + duration.value(15, 's')
        && after.eventSeq == before.eventSeq + 1
        && after.status in ['locked', 'finished']
        && after.attackerPlayerIds == before.attackerPlayerIds
        && after.defenderPlayerIds == before.defenderPlayerIds
        && after.updatedAt == request.time
        && (
          (
            after.status == 'locked'
            && after.attackerPlayerIds.size() >= 1
            && after.diff(before).affectedKeys().hasOnly(['eventSeq', 'updatedAt', 'status'])
          ) || (
            after.status == 'finished'
            && after.attackerPlayerIds.size() == 0
            && after.finishReason == 'join_failed'
            && after.winnerAllianceId == null
            && after.winnerSide == null
            && after.diff(before).affectedKeys()
              .hasOnly(['eventSeq', 'updatedAt', 'status', 'finishReason', 'winnerSide', 'winnerAllianceId'])
          )
        );
    }

    function isGenericBattleEventType(t) {
      return t in [
        'card_blocked',
        'card_countered',
      ];
    }

    function isBattleEventDoc(battleId, eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'eventId',
          'battleId',
          'playerId',
          'type',
          'seq',
          'createdAt',
          'schemaVersion',
          'meta'
        ])
        && d.eventId == eventId
        && d.battleId == battleId
        && d.playerId is string
        && d.playerId.size() > 0
        && d.playerId.size() < 64
        && d.seq is int
        && d.seq > 0
        && d.createdAt == request.time
        && d.schemaVersion == 1
        && d.meta is map
        && d.meta.size() <= 8;
    }

    function battleAfter(battleId) {
      return getAfter(/databases/$(database)/documents/battles/$(battleId)).data;
    }

    function isNextEventSeq(battleId) {
      return exists(/databases/$(database)/documents/battles/$(battleId))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && request.resource.data.seq == battleData(battleId).eventSeq + 1
        && request.resource.data.seq == battleAfter(battleId).eventSeq;
    }

    function isValidBattleEventCreate(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && isGenericBattleEventType(d.type)
        && isNextEventSeq(battleId)
        && battleData(battleId).status != 'finished'
        && (
          (
            battleData(battleId).keys().hasAny(['attackerUids'])
            && request.auth.uid in battleData(battleId).attackerUids
          )
          || (
            battleData(battleId).keys().hasAny(['defenderUids'])
            && request.auth.uid in battleData(battleId).defenderUids
          )
        );
    }

    function isValidBattleCreatedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && !exists(/databases/$(database)/documents/battles/$(battleId))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && battleAfter(battleId).eventSeq == 1
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'battle_created'
        && d.seq == 1;
    }

    function isValidPlayerJoinedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'player_joined'
        && isNextEventSeq(battleId)
        && battleData(battleId).status in ['joining', 'locked', 'active']
        && battleAfter(battleId).status == battleData(battleId).status
        && d.playerId in battleAfter(battleId).participantIds;
    }

    function isValidLoadoutLockedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'loadout_locked'
        && isNextEventSeq(battleId)
        && battleData(battleId).status == 'joining'
        && battleAfter(battleId).status == 'locked';
    }

    function isValidBattleFinishedEvent(battleId, eventId) {
      let d = request.resource.data;
      let before = battleData(battleId);
      let after = battleAfter(battleId);
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'battle_finished'
        && isNextEventSeq(battleId)
        && after.status == 'finished'
        && !d.meta.keys().hasAny(['winnerPlayerId'])
        && (
          (
            before.status == 'joining'
            && after.finishReason == 'join_failed'
            && d.meta.reason == 'join_failed'
            && !d.meta.keys().hasAny(['winnerAllianceId', 'winnerSide'])
          ) || (
            before.status == 'active'
            && d.meta.reason == after.finishReason
            && d.meta.attackerScore == after.attackerScore
            && d.meta.defenderScore == after.defenderScore
            && (
              (after.winnerAllianceId == null && !d.meta.keys().hasAny(['winnerAllianceId']))
              || d.meta.winnerAllianceId == after.winnerAllianceId
            )
          )
        );
    }

    function isValidBattleFinish() {
      let before = resource.data;
      let after = request.resource.data;
      let scoreWin = before.attackerScore != before.defenderScore
        && (before.attackerScore >= 40 || before.defenderScore >= 40);
      return request.auth != null
        && before.status == 'active'
        && after.status == 'finished'
        && after.eventSeq == before.eventSeq + 1
        && after.attackerScore == before.attackerScore
        && after.defenderScore == before.defenderScore
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.finishReason in ['score_reached', 'turn_limit']
        && (
          (after.finishReason == 'score_reached' && scoreWin)
          || (after.finishReason == 'turn_limit' && before.turn > 8 && !scoreWin)
        )
        && after.winnerAllianceId == (
          before.attackerScore > before.defenderScore
            ? before.attackerAllianceId
            : before.defenderScore > before.attackerScore
              ? before.defenderAllianceId
              : null
        )
        && after.winnerSide == (
          before.attackerScore > before.defenderScore
            ? 'attacker'
            : before.defenderScore > before.attackerScore
              ? 'defender'
              : null
        )
        && after.finishedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'eventSeq', 'updatedAt', 'status', 'finishReason', 'winnerSide',
          'winnerAllianceId', 'finishedAt', 'attackerScore', 'defenderScore'
        ])
        && after.updatedAt == request.time;
    }

    function isValidBattleResultCreate(battleId, resultId) {
      let d = request.resource.data;
      let after = battleAfter(battleId);
      return request.auth != null
        && resultId == 'final'
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && after.status == 'finished'
        && d.battleId == battleId
        && d.status == 'finished'
        && d.winnerPlayerId == null
        && d.reason == after.finishReason
        && d.attackerScore == after.attackerScore
        && d.defenderScore == after.defenderScore
        && d.winnerAllianceId == after.winnerAllianceId
        && d.winnerSide == after.winnerSide
        && d.playerDeltaWin == 8
        && d.playerDeltaLoss == 2
        && d.playerDeltaDraw == 4
        && d.allianceDeltaWin == 6
        && d.allianceDeltaLoss == 0
        && d.allianceDeltaDraw == 3
        && d.scoreWin == 40
        && d.turnLimit == 8
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.eventSeq == after.eventSeq
        && d.keys().hasOnly([
          'battleId', 'status', 'reason', 'winnerSide', 'winnerAllianceId', 'winnerPlayerId',
          'attackerScore', 'defenderScore', 'attackerAllianceId', 'defenderAllianceId',
          'playerDeltas', 'allianceDeltas', 'participantIds', 'eventSeq',
          'playerDeltaWin', 'playerDeltaLoss', 'playerDeltaDraw',
          'allianceDeltaWin', 'allianceDeltaLoss', 'allianceDeltaDraw',
          'scoreWin', 'turnLimit', 'schemaVersion', 'createdAt'
        ]);
    }

    function isValidTurnStartedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'turn_started'
        && isNextEventSeq(battleId)
        && battleData(battleId).status in ['joining', 'locked']
        && battleAfter(battleId).status == 'active';
    }

    function isValidCooldownWrite(allianceId) {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'lastBattleId',
          'lastBattleAt',
          'cooldownUntil',
          'attackerAllianceId',
          'updatedAt'
        ])
        && d.lastBattleId is string
        && d.attackerAllianceId is string
        && d.lastBattleAt == request.time
        && d.updatedAt == request.time
        && d.cooldownUntil is timestamp
        && d.cooldownUntil > request.time + duration.value(2, 'h')
        && d.cooldownUntil < request.time + duration.value(4, 'h')
        && exists(/databases/$(database)/documents/alliances/$(allianceId))
        && existsAfter(/databases/$(database)/documents/battles/$(d.lastBattleId))
        && getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data.kind == 'alliance_map'
        && getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data.defenderAllianceId == allianceId
        && getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data.attackerAllianceId == d.attackerAllianceId
        && request.auth.uid in getAfter(/databases/$(database)/documents/battles/$(d.lastBattleId)).data.attackerUids;
    }

    function battleData(battleId) {
      return get(/databases/$(database)/documents/battles/$(battleId)).data;
    }

    function isLoadoutCardId(id) {
      return id in [
        '2x', 'casus', 'duman', 'guzgu', 'joker', 'ogru', 'qaya', 'qul',
        'qutb', 'sehrbaz', 'tikanli', 'felaket', 'usyan', 'zombi', 'mutant'
      ];
    }

    function isValidLoadoutCardList(ids) {
      return ids is list
        && ids.size() == 5
        && isLoadoutCardId(ids[0])
        && isLoadoutCardId(ids[1])
        && isLoadoutCardId(ids[2])
        && isLoadoutCardId(ids[3])
        && isLoadoutCardId(ids[4])
        && ids[0] != ids[1] && ids[0] != ids[2] && ids[0] != ids[3] && ids[0] != ids[4]
        && ids[1] != ids[2] && ids[1] != ids[3] && ids[1] != ids[4]
        && ids[2] != ids[3] && ids[2] != ids[4]
        && ids[3] != ids[4];
    }

    function playerOwnsLoadoutCard(p, cardId) {
      return (p.keys().hasAny(['battleCards']) && cardId in p.battleCards && p.battleCards[cardId] is int && p.battleCards[cardId] >= 1)
        || (p.keys().hasAny(['loadoutCards']) && cardId in p.loadoutCards && p.loadoutCards[cardId] is int && p.loadoutCards[cardId] >= 1);
    }

    function playerOwnsLoadout(playerId, ids) {
      return request.auth != null && playerId is string && playerId.size() > 0 && isValidLoadoutCardList(ids);
    }

    function uidOwnsBattleSlot(b, playerId, side) {
      return (
        side == 'attacker'
        && b.attackerPlayerIds is list
        && b.attackerUids is list
        && (
          (b.attackerPlayerIds.size() > 0 && b.attackerPlayerIds[0] == playerId && b.attackerUids[0] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 1 && b.attackerPlayerIds[1] == playerId && b.attackerUids[1] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 2 && b.attackerPlayerIds[2] == playerId && b.attackerUids[2] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 3 && b.attackerPlayerIds[3] == playerId && b.attackerUids[3] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 4 && b.attackerPlayerIds[4] == playerId && b.attackerUids[4] == request.auth.uid)
        )
      ) || (
        side == 'defender'
        && b.defenderPlayerIds is list
        && b.defenderUids is list
        && (
          (b.defenderPlayerIds.size() > 0 && b.defenderPlayerIds[0] == playerId && b.defenderUids[0] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 1 && b.defenderPlayerIds[1] == playerId && b.defenderUids[1] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 2 && b.defenderPlayerIds[2] == playerId && b.defenderUids[2] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 3 && b.defenderPlayerIds[3] == playerId && b.defenderUids[3] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 4 && b.defenderPlayerIds[4] == playerId && b.defenderUids[4] == request.auth.uid)
        )
      );
    }

    function isLoadoutTeamRead(battleId) {
      let b = battleData(battleId);
      return request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || (resource.data.side == 'attacker' && request.auth.uid in b.attackerUids)
          || (resource.data.side == 'defender' && request.auth.uid in b.defenderUids)
        );
    }

    function isValidLoadoutWrite(battleId, playerId, creating) {
      let d = request.resource.data;
      let b = battleData(battleId);
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && (
          b.status in ['joining', 'locked']
          || (b.status == 'active' && creating)
        )
        && officialLoadoutEnergy(d.cardIds) > 0
        && officialLoadoutEnergy(d.cardIds) <= 25
        && d.ownerUid == request.auth.uid
        && d.battleId == battleId
        && d.playerId == playerId
        && d.side in ['attacker', 'defender']
        && d.locked is bool
        && d.schemaVersion == 1
        && d.updatedAt == request.time
        && (d.committedAt == null || d.committedAt == request.time)
        && isValidLoadoutCardList(d.cardIds)
        && playerOwnsLoadout(playerId, d.cardIds)
        && uidOwnsBattleSlot(b, playerId, d.side)
        && (
          creating
            ? d.keys().hasOnly([
                'battleId', 'playerId', 'side', 'ownerUid', 'cardIds',
                'locked', 'schemaVersion', 'committedAt', 'updatedAt'
              ])
            : resource.data.ownerUid == request.auth.uid
              && resource.data.locked != true
              && resource.data.playerId == playerId
              && resource.data.side == d.side
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['cardIds', 'locked', 'updatedAt', 'committedAt'])
        );
    }

    function officialCardCooldownSec(id) {
      return id == '2x' ? 8
        : id == 'casus' ? 6
        : id == 'duman' ? 5
        : id == 'guzgu' ? 10
        : id == 'joker' ? 12
        : id == 'ogru' ? 8
        : id == 'qaya' ? 7
        : id == 'qul' ? 14
        : id == 'qutb' ? 12
        : id == 'sehrbaz' ? 8
        : id == 'tikanli' ? 10
        : id == 'felaket' ? 14
        : id == 'usyan' ? 12
        : id == 'zombi' ? 10
        : id == 'mutant' ? 10
        : 0;
    }

    function officialDamage(id) {
      return id == '2x' ? 0
        : id == 'casus' ? 0
        : id == 'duman' ? 0
        : id == 'guzgu' ? 4
        : id == 'joker' ? 5
        : id == 'ogru' ? 0
        : id == 'qaya' ? 6
        : id == 'qul' ? 3
        : id == 'qutb' ? 7
        : id == 'sehrbaz' ? 4
        : id == 'tikanli' ? 5
        : id == 'felaket' ? 9
        : id == 'usyan' ? 3
        : id == 'zombi' ? 6
        : id == 'mutant' ? 6
        : -1;
    }

    function officialPlayerDelta(id) {
      return id == '2x' ? 8
        : id == 'casus' ? 3
        : id == 'duman' ? 2
        : id == 'guzgu' ? 4
        : id == 'joker' ? 5
        : id == 'ogru' ? 4
        : id == 'qaya' ? 3
        : id == 'qul' ? 4
        : id == 'qutb' ? 5
        : id == 'sehrbaz' ? 4
        : id == 'tikanli' ? 3
        : id == 'felaket' ? 6
        : id == 'usyan' ? 5
        : id == 'zombi' ? 4
        : id == 'mutant' ? 4
        : -1;
    }

    function officialAllianceDelta(id) {
      return id == '2x' ? 4
        : id == 'casus' ? 1
        : id == 'duman' ? 1
        : id == 'guzgu' ? 2
        : id == 'joker' ? 3
        : id == 'ogru' ? 0
        : id == 'qaya' ? 2
        : id == 'qul' ? 2
        : id == 'qutb' ? 3
        : id == 'sehrbaz' ? 2
        : id == 'tikanli' ? 2
        : id == 'felaket' ? 4
        : id == 'usyan' ? 3
        : id == 'zombi' ? 2
        : id == 'mutant' ? 2
        : -1;
    }

    function officialClickBand(allianceId) {
      let n = allianceId is string
        && allianceId.size() > 0
        && exists(/databases/$(database)/documents/alliances/$(allianceId))
        && get(/databases/$(database)/documents/alliances/$(allianceId)).data.keys().hasAny(['members'])
        && get(/databases/$(database)/documents/alliances/$(allianceId)).data.members is list
          ? get(/databases/$(database)/documents/alliances/$(allianceId)).data.members.size()
          : 1;
      return n <= 5 ? 3 : n <= 15 ? 5 : 7;
    }

    function officialChallengeClicks(cardId, allianceId) {
      return cardId == 'usyan' ? officialClickBand(allianceId) * 2
        : (cardId == 'qul' || cardId == 'qutb' || cardId == 'felaket' || cardId == 'zombi' || cardId == 'mutant')
          ? officialClickBand(allianceId)
          : 0;
    }

    function officialSteal(id) {
      return id == 'ogru' ? 4
        : id == 'tikanli' ? 2
        : id == 'usyan' ? 2
        : id == '2x' ? 0
        : id == 'casus' ? 0
        : id == 'duman' ? 0
        : id == 'guzgu' ? 0
        : id == 'joker' ? 0
        : id == 'qaya' ? 0
        : id == 'qul' ? 0
        : id == 'qutb' ? 0
        : id == 'sehrbaz' ? 0
        : id == 'felaket' ? 0
        : id == 'zombi' ? 0
        : id == 'mutant' ? 0
        : -1;
    }

    function officialCardCost(id) {
      return id == '2x' ? 5
        : id == 'casus' ? 5
        : id == 'duman' ? 4
        : id == 'guzgu' ? 4
        : id == 'joker' ? 4
        : id == 'ogru' ? 3
        : id == 'qaya' ? 5
        : id == 'qul' ? 4
        : id == 'qutb' ? 3
        : id == 'sehrbaz' ? 5
        : id == 'tikanli' ? 4
        : id == 'felaket' ? 3
        : id == 'usyan' ? 4
        : id == 'zombi' ? 4
        : id == 'mutant' ? 4
        : 0;
    }

    function officialLoadoutEnergy(ids) {
      return officialCardCost(ids[0]) + officialCardCost(ids[1]) + officialCardCost(ids[2])
        + officialCardCost(ids[3]) + officialCardCost(ids[4]);
    }

    function isValidCardPlaySeqBump(battleId) {
      let before = resource.data;
      let after = request.resource.data;
      let receipt = getAfter(/databases/$(database)/documents/battles/$(battleId)/energy_requests/$(after.lastScoreRequestId)).data;
      let atk0 = before.keys().hasAny(['attackerScore']) && before.attackerScore is int ? before.attackerScore : 0;
      let def0 = before.keys().hasAny(['defenderScore']) && before.defenderScore is int ? before.defenderScore : 0;
      let scoreV0 = before.keys().hasAny(['scoreVersion']) && before.scoreVersion is int ? before.scoreVersion : 0;
      return request.auth != null
        && before.status == 'active'
        && after.status == 'active'
        && after.eventSeq == before.eventSeq + 6
        && after.stateVersion == before.stateVersion + 1
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.schemaVersion == before.schemaVersion
        && after.turn is int
        && after.turn >= 1
        && after.turnSide in ['attacker', 'defender']
        && after.turnPlayerId is string
        && (
          (after.turnSide == 'attacker' && after.turnPlayerId in after.attackerPlayerIds)
          || (after.turnSide == 'defender' && after.turnPlayerId in after.defenderPlayerIds)
        )
        && after.turnStartAt == request.time
        && after.turnDurationMs == 15000
        && request.time < before.turnStartAt + duration.value(15, 's')
        && after.lastScoreRequestId is string
        && receipt.requestId == after.lastScoreRequestId
        && officialDamage(receipt.cardId) >= 0
        && receipt.damage == officialDamage(receipt.cardId)
        && receipt.playerDelta == officialPlayerDelta(receipt.cardId)
        && receipt.allianceDelta == officialAllianceDelta(receipt.cardId)
        && receipt.steal == officialSteal(receipt.cardId)
        && receipt.playerDelta >= 0
        && receipt.allianceDelta >= 0
        && receipt.steal >= 0
        && receipt.taken is int
        && receipt.taken >= 0
        && receipt.taken <= receipt.steal
        && after.attackerScore is int
        && after.defenderScore is int
        && after.attackerScore == receipt.attackerScoreAfter
        && after.defenderScore == receipt.defenderScoreAfter
        && after.attackerScore >= 0
        && after.defenderScore >= 0
        && after.attackerScore <= 1000000
        && after.defenderScore <= 1000000
        && after.attackerScore >= atk0 - receipt.taken
        && after.defenderScore >= def0 - receipt.taken
        && after.scoreVersion == scoreV0 + 1
        && after.diff(before).affectedKeys()
          .hasOnly([
            'eventSeq', 'updatedAt', 'status', 'turn', 'turnSide', 'turnPlayerId',
            'stateVersion', 'turnStartAt', 'turnDurationMs',
            'attackerScore', 'defenderScore', 'scoreVersion', 'lastScoreRequestId'
          ])
        && after.updatedAt == request.time;
    }

    function isValidBattleActivate() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.kind == 'alliance_map'
        && before.status in ['joining', 'locked']
        && after.status == 'active'
