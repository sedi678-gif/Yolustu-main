rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isProtectedPath(path) {
      return path.size() > 0 && (
        path[0] == 'battles' ||
        path[0] == 'alliance_battle_cooldowns' ||
        path[0] == 'battle_card_costs' ||
        path[0] == 'server_clock'
      );
    }

    function isBattleEventType(t) {
      return t in [
        'battle_created',
        'player_joined',
        'player_left',
        'loadout_locked',
        'card_played',
        'energy_changed',
        'card_blocked',
        'card_countered',
        'click_started',
        'click_completed',
        'damage_applied',
        'score_changed',
        'turn_started',
        'turn_timeout',
        'battle_finished'
      ];
    }

    function isValidOpenBattleCreate() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'createdBy',
          'createdAt',
          'updatedAt',
          'status',
          'eventSeq',
          'participantIds',
          'schemaVersion',
          'attackerScore',
          'defenderScore',
          'scoreVersion',
          'lastScoreRequestId'
        ])
        && d.createdBy is string
        && d.createdBy.size() > 0
        && d.createdBy.size() < 64
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.status == 'open'
        && d.eventSeq == 1
        && d.participantIds is list
        && d.participantIds.size() == 1
        && d.schemaVersion == 1
        && d.attackerScore == 0
        && d.defenderScore == 0
        && d.scoreVersion == 0
        && d.lastScoreRequestId == null;
    }

    function isValidMapBattleCreate() {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'createdBy',
          'createdAt',
          'updatedAt',
          'status',
          'eventSeq',
          'participantIds',
          'schemaVersion',
          'kind',
          'attackerAllianceId',
          'defenderAllianceId',
          'attackerAllianceName',
          'defenderAllianceName',
          'attackerPlayerIds',
          'defenderPlayerIds',
          'attackerUids',
          'defenderUids',
          'joinDurationMs',
          'attackerScore',
          'defenderScore',
          'scoreVersion',
          'lastScoreRequestId'
        ])
        && d.createdBy is string
        && d.createdBy.size() > 0
        && d.createdBy.size() < 64
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.status == 'joining'
        && d.kind == 'alliance_map'
        && d.eventSeq == 1
        && d.schemaVersion == 1
        && d.joinDurationMs == 15000
        && d.attackerAllianceId is string
        && d.defenderAllianceId is string
        && d.attackerAllianceId != d.defenderAllianceId
        && d.attackerPlayerIds is list
        && d.attackerPlayerIds.size() == 1
        && d.defenderPlayerIds is list
        && d.defenderPlayerIds.size() == 0
        && d.attackerUids is list
        && d.attackerUids.size() == 1
        && d.attackerUids[0] == request.auth.uid
        && d.defenderUids is list
        && d.defenderUids.size() == 0
        && d.participantIds == d.attackerPlayerIds
        && d.attackerScore == 0
        && d.defenderScore == 0
        && d.scoreVersion == 0
        && d.lastScoreRequestId == null
        && exists(/databases/$(database)/documents/alliances/$(d.defenderAllianceId))
        && exists(/databases/$(database)/documents/alliances/$(d.attackerAllianceId));
    }

    function isValidLegacySeqBump() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && after.eventSeq == before.eventSeq + 1
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.schemaVersion == before.schemaVersion
        && after.diff(before).affectedKeys()
          .hasOnly(['eventSeq', 'updatedAt', 'status', 'participantIds'])
        && after.status in ['open', 'joining', 'locked', 'active', 'finished']
        && after.participantIds is list
        && after.participantIds.size() <= 10
        && after.updatedAt == request.time;
    }

    function isValidMapBattleJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.kind == 'alliance_map'
        && before.status == 'joining'
        && after.status == 'joining'
        && request.time < before.createdAt + duration.value(15, 's')
        && after.eventSeq == before.eventSeq + 1
        && after.createdAt == before.createdAt
        && after.joinDurationMs == before.joinDurationMs
        && after.attackerAllianceId == before.attackerAllianceId
        && after.defenderAllianceId == before.defenderAllianceId
        && after.attackerPlayerIds is list
        && after.defenderPlayerIds is list
        && after.attackerPlayerIds.size() <= 5
        && after.defenderPlayerIds.size() <= 5
        && after.attackerPlayerIds.size() >= before.attackerPlayerIds.size()
        && after.defenderPlayerIds.size() >= before.defenderPlayerIds.size()
        && after.attackerPlayerIds.size() + after.defenderPlayerIds.size()
          == before.attackerPlayerIds.size() + before.defenderPlayerIds.size() + 1
        && after.attackerUids is list
        && after.defenderUids is list
        && after.attackerUids.size() == after.attackerPlayerIds.size()
        && after.defenderUids.size() == after.defenderPlayerIds.size()
        && after.attackerUids.size() + after.defenderUids.size()
          == before.attackerUids.size() + before.defenderUids.size() + 1
        && (
          (
            after.attackerPlayerIds.size() == before.attackerPlayerIds.size() + 1
            && after.defenderUids == before.defenderUids
            && request.auth.uid in after.attackerUids
          ) || (
            after.defenderPlayerIds.size() == before.defenderPlayerIds.size() + 1
            && after.attackerUids == before.attackerUids
            && request.auth.uid in after.defenderUids
          )
        )
        && after.diff(before).affectedKeys()
          .hasOnly([
            'eventSeq',
            'updatedAt',
            'participantIds',
            'attackerPlayerIds',
            'defenderPlayerIds',
            'attackerUids',
            'defenderUids'
          ])
        && after.updatedAt == request.time;
    }

    function isValidMapBattleLock() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.kind == 'alliance_map'
        && before.status == 'joining'
        && request.time >= before.createdAt + duration.value(15, 's')
        && after.eventSeq == before.eventSeq + 1
        && after.status in ['locked', 'finished']
        && after.attackerPlayerIds == before.attackerPlayerIds
        && after.defenderPlayerIds == before.defenderPlayerIds
        && after.diff(before).affectedKeys().hasOnly(['eventSeq', 'updatedAt', 'status'])
        && after.updatedAt == request.time;
    }

    function isGenericBattleEventType(t) {
      return t in [
        'card_blocked',
        'card_countered',
        'click_started',
        'click_completed'
      ];
    }

    function isBattleEventDoc(battleId, eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'eventId',
          'battleId',
          'playerId',
          'type',
          'seq',
          'createdAt',
          'schemaVersion',
          'meta'
        ])
        && d.eventId == eventId
        && d.battleId == battleId
        && d.playerId is string
        && d.playerId.size() > 0
        && d.playerId.size() < 64
        && d.seq is int
        && d.seq > 0
        && d.createdAt == request.time
        && d.schemaVersion == 1
        && d.meta is map
        && d.meta.size() <= 8;
    }

    function battleAfter(battleId) {
      return getAfter(/databases/$(database)/documents/battles/$(battleId)).data;
    }

    function isNextEventSeq(battleId) {
      return exists(/databases/$(database)/documents/battles/$(battleId))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && request.resource.data.seq == battleData(battleId).eventSeq + 1
        && request.resource.data.seq == battleAfter(battleId).eventSeq;
    }

    function isValidBattleEventCreate(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && isGenericBattleEventType(d.type)
        && isNextEventSeq(battleId)
        && battleData(battleId).status != 'finished';
    }

    function isValidBattleCreatedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && !exists(/databases/$(database)/documents/battles/$(battleId))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && battleAfter(battleId).eventSeq == 1
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'battle_created'
        && d.seq == 1;
    }

    function isValidPlayerJoinedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'player_joined'
        && isNextEventSeq(battleId)
        && battleData(battleId).status == 'joining'
        && battleAfter(battleId).status == 'joining'
        && d.playerId in battleAfter(battleId).participantIds;
    }

    function isValidLoadoutLockedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'loadout_locked'
        && isNextEventSeq(battleId)
        && battleData(battleId).status == 'joining'
        && battleAfter(battleId).status == 'locked';
    }

    function isValidBattleFinishedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'battle_finished'
        && isNextEventSeq(battleId)
        && battleAfter(battleId).status == 'finished';
    }

    function isValidTurnStartedEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'turn_started'
        && isNextEventSeq(battleId)
        && battleData(battleId).status == 'locked'
        && battleAfter(battleId).status == 'active';
    }

    function isValidCooldownWrite(allianceId) {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly([
          'lastBattleId',
          'lastBattleAt',
          'cooldownUntil',
          'attackerAllianceId',
          'updatedAt'
        ])
        && d.lastBattleId is string
        && d.attackerAllianceId is string
        && d.lastBattleAt == request.time
        && d.updatedAt == request.time
        && d.cooldownUntil is timestamp
        && d.cooldownUntil > request.time + duration.value(2, 'h')
        && d.cooldownUntil < request.time + duration.value(4, 'h')
        && exists(/databases/$(database)/documents/alliances/$(allianceId));
    }

    function battleData(battleId) {
      return get(/databases/$(database)/documents/battles/$(battleId)).data;
    }

    function isLoadoutCardId(id) {
      return id in [
        '2x', 'casus', 'duman', 'guzgu', 'joker', 'ogru', 'qaya', 'qul',
        'qutb', 'sehrbaz', 'tikanli', 'felaket', 'usyan', 'zombi', 'mutant'
      ];
    }

    function isValidLoadoutCardList(ids) {
      return ids is list
        && ids.size() == 5
        && isLoadoutCardId(ids[0])
        && isLoadoutCardId(ids[1])
        && isLoadoutCardId(ids[2])
        && isLoadoutCardId(ids[3])
        && isLoadoutCardId(ids[4])
        && ids[0] != ids[1] && ids[0] != ids[2] && ids[0] != ids[3] && ids[0] != ids[4]
        && ids[1] != ids[2] && ids[1] != ids[3] && ids[1] != ids[4]
        && ids[2] != ids[3] && ids[2] != ids[4]
        && ids[3] != ids[4];
    }

    function playerOwnsLoadoutCard(p, cardId) {
      return (p.keys().hasAny(['battleCards']) && cardId in p.battleCards && p.battleCards[cardId] is int && p.battleCards[cardId] >= 1)
        || (p.keys().hasAny(['loadoutCards']) && cardId in p.loadoutCards && p.loadoutCards[cardId] is int && p.loadoutCards[cardId] >= 1);
    }

    function playerOwnsLoadout(playerId, ids) {
      return playerId == '1' || (
        exists(/databases/$(database)/documents/players/$(playerId))
        && playerOwnsLoadoutCard(get(/databases/$(database)/documents/players/$(playerId)).data, ids[0])
        && playerOwnsLoadoutCard(get(/databases/$(database)/documents/players/$(playerId)).data, ids[1])
        && playerOwnsLoadoutCard(get(/databases/$(database)/documents/players/$(playerId)).data, ids[2])
        && playerOwnsLoadoutCard(get(/databases/$(database)/documents/players/$(playerId)).data, ids[3])
        && playerOwnsLoadoutCard(get(/databases/$(database)/documents/players/$(playerId)).data, ids[4])
      );
    }

    function uidOwnsBattleSlot(b, playerId, side) {
      return (
        side == 'attacker'
        && b.attackerPlayerIds is list
        && b.attackerUids is list
        && (
          (b.attackerPlayerIds.size() > 0 && b.attackerPlayerIds[0] == playerId && b.attackerUids[0] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 1 && b.attackerPlayerIds[1] == playerId && b.attackerUids[1] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 2 && b.attackerPlayerIds[2] == playerId && b.attackerUids[2] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 3 && b.attackerPlayerIds[3] == playerId && b.attackerUids[3] == request.auth.uid)
          || (b.attackerPlayerIds.size() > 4 && b.attackerPlayerIds[4] == playerId && b.attackerUids[4] == request.auth.uid)
        )
      ) || (
        side == 'defender'
        && b.defenderPlayerIds is list
        && b.defenderUids is list
        && (
          (b.defenderPlayerIds.size() > 0 && b.defenderPlayerIds[0] == playerId && b.defenderUids[0] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 1 && b.defenderPlayerIds[1] == playerId && b.defenderUids[1] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 2 && b.defenderPlayerIds[2] == playerId && b.defenderUids[2] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 3 && b.defenderPlayerIds[3] == playerId && b.defenderUids[3] == request.auth.uid)
          || (b.defenderPlayerIds.size() > 4 && b.defenderPlayerIds[4] == playerId && b.defenderUids[4] == request.auth.uid)
        )
      );
    }

    function isLoadoutTeamRead(battleId) {
      let b = battleData(battleId);
      return request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || (resource.data.side == 'attacker' && request.auth.uid in b.attackerUids)
          || (resource.data.side == 'defender' && request.auth.uid in b.defenderUids)
        );
    }

    function isValidLoadoutWrite(battleId, playerId, creating) {
      let d = request.resource.data;
      let b = battleData(battleId);
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && b.status in ['joining', 'locked']
        && d.ownerUid == request.auth.uid
        && d.battleId == battleId
        && d.playerId == playerId
        && d.side in ['attacker', 'defender']
        && d.locked is bool
        && d.schemaVersion == 1
        && d.updatedAt == request.time
        && (d.committedAt == null || d.committedAt == request.time)
        && isValidLoadoutCardList(d.cardIds)
        && playerOwnsLoadout(playerId, d.cardIds)
        && uidOwnsBattleSlot(b, playerId, d.side)
        && (
          creating
            ? d.keys().hasOnly([
                'battleId', 'playerId', 'side', 'ownerUid', 'cardIds',
                'locked', 'schemaVersion', 'committedAt', 'updatedAt'
              ])
            : resource.data.ownerUid == request.auth.uid
              && resource.data.locked != true
              && resource.data.playerId == playerId
              && resource.data.side == d.side
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['cardIds', 'locked', 'updatedAt', 'committedAt'])
        );
    }

    function officialCardCooldownSec(id) {
      return id == '2x' ? 8
        : id == 'casus' ? 6
        : id == 'duman' ? 5
        : id == 'guzgu' ? 10
        : id == 'joker' ? 12
        : id == 'ogru' ? 8
        : id == 'qaya' ? 7
        : id == 'qul' ? 14
        : id == 'qutb' ? 12
        : id == 'sehrbaz' ? 8
        : id == 'tikanli' ? 10
        : id == 'felaket' ? 14
        : id == 'usyan' ? 12
        : id == 'zombi' ? 10
        : id == 'mutant' ? 10
        : 0;
    }

    function officialDamage(id) {
      return id == '2x' ? 0
        : id == 'casus' ? 0
        : id == 'duman' ? 0
        : id == 'guzgu' ? 4
        : id == 'joker' ? 5
        : id == 'ogru' ? 0
        : id == 'qaya' ? 6
        : id == 'qul' ? 3
        : id == 'qutb' ? 7
        : id == 'sehrbaz' ? 4
        : id == 'tikanli' ? 5
        : id == 'felaket' ? 9
        : id == 'usyan' ? 3
        : id == 'zombi' ? 6
        : id == 'mutant' ? 6
        : -1;
    }

    function officialPlayerDelta(id) {
      return id == '2x' ? 8
        : id == 'casus' ? 3
        : id == 'duman' ? 2
        : id == 'guzgu' ? 4
        : id == 'joker' ? 5
        : id == 'ogru' ? 4
        : id == 'qaya' ? 3
        : id == 'qul' ? 4
        : id == 'qutb' ? 5
        : id == 'sehrbaz' ? 4
        : id == 'tikanli' ? 3
        : id == 'felaket' ? 6
        : id == 'usyan' ? 5
        : id == 'zombi' ? 4
        : id == 'mutant' ? 4
        : -1;
    }

    function officialAllianceDelta(id) {
      return id == '2x' ? 4
        : id == 'casus' ? 1
        : id == 'duman' ? 1
        : id == 'guzgu' ? 2
        : id == 'joker' ? 3
        : id == 'ogru' ? 0
        : id == 'qaya' ? 2
        : id == 'qul' ? 2
        : id == 'qutb' ? 3
        : id == 'sehrbaz' ? 2
        : id == 'tikanli' ? 2
        : id == 'felaket' ? 4
        : id == 'usyan' ? 3
        : id == 'zombi' ? 2
        : id == 'mutant' ? 2
        : -1;
    }

    function officialSteal(id) {
      return id == 'ogru' ? 4
        : id == 'tikanli' ? 2
        : id == 'usyan' ? 2
        : id == '2x' ? 0
        : id == 'casus' ? 0
        : id == 'duman' ? 0
        : id == 'guzgu' ? 0
        : id == 'joker' ? 0
        : id == 'qaya' ? 0
        : id == 'qul' ? 0
        : id == 'qutb' ? 0
        : id == 'sehrbaz' ? 0
        : id == 'felaket' ? 0
        : id == 'zombi' ? 0
        : id == 'mutant' ? 0
        : -1;
    }

    function officialCardCost(id) {
      return id == '2x' ? 6
        : id == 'casus' ? 4
        : id == 'duman' ? 3
        : id == 'guzgu' ? 7
        : id == 'joker' ? 8
        : id == 'ogru' ? 6
        : id == 'qaya' ? 5
        : id == 'qul' ? 9
        : id == 'qutb' ? 8
        : id == 'sehrbaz' ? 6
        : id == 'tikanli' ? 7
        : id == 'felaket' ? 9
        : id == 'usyan' ? 8
        : id == 'zombi' ? 7
        : id == 'mutant' ? 7
        : 0;
    }

    function isValidCardPlaySeqBump(battleId) {
      let before = resource.data;
      let after = request.resource.data;
      let receipt = getAfter(/databases/$(database)/documents/battles/$(battleId)/energy_requests/$(after.lastScoreRequestId)).data;
      let atk0 = before.keys().hasAny(['attackerScore']) && before.attackerScore is int ? before.attackerScore : 0;
      let def0 = before.keys().hasAny(['defenderScore']) && before.defenderScore is int ? before.defenderScore : 0;
      let scoreV0 = before.keys().hasAny(['scoreVersion']) && before.scoreVersion is int ? before.scoreVersion : 0;
      return request.auth != null
        && before.status == 'active'
        && after.status == 'active'
        && after.eventSeq == before.eventSeq + 6
        && after.stateVersion == before.stateVersion + 1
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.schemaVersion == before.schemaVersion
        && after.turn is int
        && after.turn >= 1
        && after.turnSide in ['attacker', 'defender']
        && after.turnPlayerId is string
        && (
          (after.turnSide == 'attacker' && after.turnPlayerId in after.attackerPlayerIds)
          || (after.turnSide == 'defender' && after.turnPlayerId in after.defenderPlayerIds)
        )
        && after.turnStartAt == request.time
        && after.turnDurationMs == 15000
        && request.time < before.turnStartAt + duration.value(15, 's')
        && after.lastScoreRequestId is string
        && receipt.requestId == after.lastScoreRequestId
        && officialDamage(receipt.cardId) >= 0
        && receipt.damage == officialDamage(receipt.cardId)
        && receipt.playerDelta == officialPlayerDelta(receipt.cardId)
        && receipt.allianceDelta == officialAllianceDelta(receipt.cardId)
        && receipt.steal == officialSteal(receipt.cardId)
        && receipt.playerDelta >= 0
        && receipt.allianceDelta >= 0
        && receipt.steal >= 0
        && receipt.taken is int
        && receipt.taken >= 0
        && receipt.taken <= receipt.steal
        && after.attackerScore is int
        && after.defenderScore is int
        && after.attackerScore == receipt.attackerScoreAfter
        && after.defenderScore == receipt.defenderScoreAfter
        && after.attackerScore >= 0
        && after.defenderScore >= 0
        && after.attackerScore <= 1000000
        && after.defenderScore <= 1000000
        && after.attackerScore >= atk0 - receipt.taken
        && after.defenderScore >= def0 - receipt.taken
        && after.scoreVersion == scoreV0 + 1
        && after.diff(before).affectedKeys()
          .hasOnly([
            'eventSeq', 'updatedAt', 'status', 'turn', 'turnSide', 'turnPlayerId',
            'stateVersion', 'turnStartAt', 'turnDurationMs',
            'attackerScore', 'defenderScore', 'scoreVersion', 'lastScoreRequestId'
          ])
        && after.updatedAt == request.time;
    }

    function isValidBattleActivate() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.kind == 'alliance_map'
        && before.status == 'locked'
        && after.status == 'active'
        && after.eventSeq == before.eventSeq + 1
        && after.stateVersion == 1
        && after.turn == 1
        && after.turnSide == 'attacker'
        && after.turnPlayerId == after.attackerPlayerIds[0]
        && after.turnStartAt == request.time
        && after.turnDurationMs == 15000
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.diff(before).affectedKeys()
          .hasOnly([
            'eventSeq', 'updatedAt', 'status', 'turn', 'turnSide', 'turnPlayerId',
            'stateVersion', 'turnStartAt', 'turnDurationMs'
          ])
        && after.updatedAt == request.time;
    }

    function isValidTurnTimeout() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.status == 'active'
        && request.time >= before.turnStartAt + duration.value(15, 's')
        && after.status == 'active'
        && after.eventSeq == before.eventSeq + 1
        && after.stateVersion == before.stateVersion + 1
        && after.turnStartAt == request.time
        && after.turnDurationMs == 15000
        && after.turn is int
        && after.turnSide in ['attacker', 'defender']
        && after.turnPlayerId is string
        && (
          (after.turnSide == 'attacker' && after.turnPlayerId in after.attackerPlayerIds)
          || (after.turnSide == 'defender' && after.turnPlayerId in after.defenderPlayerIds)
        )
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.diff(before).affectedKeys()
          .hasOnly([
            'eventSeq', 'updatedAt', 'status', 'turn', 'turnSide', 'turnPlayerId',
            'stateVersion', 'turnStartAt', 'turnDurationMs'
          ])
        && after.updatedAt == request.time;
    }

    function isValidTurnTimeoutEvent(battleId, eventId) {
      let d = request.resource.data;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'turn_timeout'
        && isNextEventSeq(battleId)
        && battleData(battleId).status == 'active'
        && request.time >= battleData(battleId).turnStartAt + duration.value(15, 's');
    }

    function energyReceipt(battleId, requestId) {
      return getAfter(/databases/$(database)/documents/battles/$(battleId)/energy_requests/$(requestId)).data;
    }

    function isValidEnergyInit(battleId, playerId) {
      let d = request.resource.data;
      let b = getAfter(/databases/$(database)/documents/battles/$(battleId)).data;
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && b.status in ['open', 'joining', 'locked']
        && d.battleId == battleId
        && d.playerId == playerId
        && d.energy == 30
        && d.maxEnergy == 30
        && d.cardUsage is map
        && d.cardUsage.size() == 0
        && d.cardCooldownUntil is map
        && d.cardCooldownUntil.size() == 0
        && d.lastRequestId == null
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.keys().hasOnly([
          'battleId', 'playerId', 'energy', 'maxEnergy', 'cardUsage',
          'cardCooldownUntil', 'lastRequestId', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && playerId in b.participantIds
        && (
          b.kind != 'alliance_map'
          || uidOwnsBattleSlot(b, playerId, 'attacker')
          || uidOwnsBattleSlot(b, playerId, 'defender')
        );
    }

    function isValidEnergySpend(battleId, playerId) {
      let before = resource.data;
      let after = request.resource.data;
      let reqId = after.lastRequestId;
      let receipt = energyReceipt(battleId, reqId);
      let cid = receipt.cardId;
      let prevUse = (before.keys().hasAny(['cardUsage']) && cid in before.cardUsage && before.cardUsage[cid] is int)
        ? before.cardUsage[cid]
        : ((before.keys().hasAny(['usedCardIds']) && cid in before.usedCardIds) ? 1 : 0);
      let cdReady = !(before.keys().hasAny(['cardCooldownUntil']))
        || !(cid in before.cardCooldownUntil)
        || (
          before.cardCooldownUntil[cid] is int
          && request.time.toMillis() >= before.cardCooldownUntil[cid]
        );
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && battleData(battleId).status == 'active'
        && battleData(battleId).turnPlayerId == playerId
        && request.time < battleData(battleId).turnStartAt + duration.value(15, 's')
        && reqId is string
        && reqId.size() >= 8
        && receipt.playerId == playerId
        && receipt.requestId == reqId
        && cid is string
        && officialCardCost(cid) > 0
        && officialCardCooldownSec(cid) > 0
        && receipt.cost == officialCardCost(cid)
        && receipt.energyBefore == before.energy
        && receipt.energyAfter == after.energy
        && after.energy == before.energy - receipt.cost
        && after.energy >= 0
        && after.energy <= 30
        && before.energy >= 0
        && after.maxEnergy == 30
        && prevUse < 3
        && after.cardUsage is map
        && after.cardUsage[cid] == prevUse + 1
        && after.cardUsage[cid] <= 3
        && cdReady
        && after.cardCooldownUntil is map
        && after.cardCooldownUntil[cid] is int
        && after.cardCooldownUntil[cid] > request.time.toMillis()
        && exists(/databases/$(database)/documents/battles/$(battleId)/loadouts/$(playerId))
        && cid in get(/databases/$(database)/documents/battles/$(battleId)/loadouts/$(playerId)).data.cardIds
        && after.diff(before).affectedKeys()
          .hasOnly(['energy', 'cardUsage', 'cardCooldownUntil', 'lastRequestId', 'updatedAt'])
        && after.updatedAt == request.time;
    }

    function isValidEnergyRequestCreate(battleId, requestId) {
      let d = request.resource.data;
      let b = battleData(battleId);
      let atk0 = b.keys().hasAny(['attackerScore']) && b.attackerScore is int ? b.attackerScore : 0;
      let def0 = b.keys().hasAny(['defenderScore']) && b.defenderScore is int ? b.defenderScore : 0;
      let own0 = d.side == 'attacker' ? atk0 : def0;
      let opp0 = d.side == 'attacker' ? def0 : atk0;
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && battleData(battleId).status == 'active'
        && request.time < battleData(battleId).turnStartAt + duration.value(15, 's')
        && d.requestId == requestId
        && d.battleId == battleId
        && d.playerId is string
        && officialCardCost(d.cardId) > 0
        && d.cost == officialCardCost(d.cardId)
        && d.energyBefore is int
        && d.energyAfter is int
        && d.energyAfter == d.energyBefore - d.cost
        && d.energyAfter >= 0
        && d.energyBefore <= 30
        && d.energyBefore >= d.cost
        && d.usageAfter is int
        && d.usageAfter > 0
        && d.usageAfter <= 3
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.side in ['attacker', 'defender']
        && (
          (d.side == 'attacker' && d.playerId in battleData(battleId).attackerPlayerIds)
          || (d.side == 'defender' && d.playerId in battleData(battleId).defenderPlayerIds)
        )
        && officialDamage(d.cardId) >= 0
        && d.damage == officialDamage(d.cardId)
        && d.playerDelta == officialPlayerDelta(d.cardId)
        && d.allianceDelta == officialAllianceDelta(d.cardId)
        && d.steal == officialSteal(d.cardId)
        && d.damage is int
        && d.playerDelta is int
        && d.allianceDelta is int
        && d.steal is int
        && d.taken is int
        && d.damage >= 0
        && d.damage <= 12
        && d.playerDelta >= 0
        && d.playerDelta <= 10
        && d.allianceDelta >= 0
        && d.allianceDelta <= 8
        && d.steal >= 0
        && d.steal <= 6
        && d.taken >= 0
        && d.taken <= d.steal
        && d.playerScoreAfter is int
        && d.attackerScoreAfter is int
        && d.defenderScoreAfter is int
        && d.ownAllianceAfter is int
        && d.oppAllianceAfter is int
        && (
          (
            exists(/databases/$(database)/documents/battles/$(battleId)/scores/$(d.playerId))
            && d.playerScoreAfter == get(/databases/$(database)/documents/battles/$(battleId)/scores/$(d.playerId)).data.score + d.playerDelta
          ) || (
            !exists(/databases/$(database)/documents/battles/$(battleId)/scores/$(d.playerId))
            && d.playerScoreAfter == d.playerDelta
          )
        )
        && d.playerScoreAfter >= d.playerDelta
        && d.playerScoreAfter <= 1000000
        && d.attackerScoreAfter >= 0
        && d.defenderScoreAfter >= 0
        && d.attackerScoreAfter <= 1000000
        && d.defenderScoreAfter <= 1000000
        && d.taken == (d.steal < opp0 ? d.steal : opp0)
        && d.ownAllianceAfter == own0 + d.allianceDelta + d.taken
        && d.oppAllianceAfter == opp0 - d.taken
        && d.ownAllianceAfter == (d.side == 'attacker' ? d.attackerScoreAfter : d.defenderScoreAfter)
        && d.oppAllianceAfter == (d.side == 'attacker' ? d.defenderScoreAfter : d.attackerScoreAfter)
        && d.eventSeq == battleData(battleId).eventSeq + 6
        && d.keys().hasOnly([
          'requestId', 'battleId', 'playerId', 'cardId', 'side', 'cost',
          'energyBefore', 'energyAfter', 'usageAfter', 'cooldownUntil',
          'eventSeq', 'stateVersion', 'turn', 'turnSide', 'turnPlayerId',
          'damage', 'playerDelta', 'allianceDelta', 'steal', 'taken',
          'playerScoreAfter', 'attackerScoreAfter', 'defenderScoreAfter',
          'ownAllianceAfter', 'oppAllianceAfter',
          'schemaVersion', 'createdAt'
        ]);
    }

    function isValidEnergyPlayEvent(battleId, eventId) {
      let d = request.resource.data;
      let reqId = d.meta.requestId;
      let receipt = energyReceipt(battleId, reqId);
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && battleAfter(battleId).eventSeq == battleData(battleId).eventSeq + 6
        && reqId is string
        && receipt.playerId == d.playerId
        && receipt.requestId == reqId
        && receipt.cardId == d.meta.cardId
        && (
          (
            d.type == 'card_played'
            && d.seq == battleData(battleId).eventSeq + 1
          ) || (
            d.type == 'energy_changed'
            && d.seq == battleData(battleId).eventSeq + 2
            && d.meta.energy == receipt.energyAfter
            && d.meta.delta == -receipt.cost
          )
        );
    }

    function isValidScorePlayEvent(battleId, eventId) {
      let d = request.resource.data;
      let reqId = d.meta.requestId;
      let receipt = energyReceipt(battleId, reqId);
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && battleAfter(battleId).eventSeq == battleData(battleId).eventSeq + 6
        && reqId is string
        && receipt.playerId == d.playerId
        && receipt.requestId == reqId
        && officialDamage(receipt.cardId) >= 0
        && (
          (
            d.type == 'damage_applied'
            && d.seq == battleData(battleId).eventSeq + 3
            && d.meta.amount == receipt.damage
            && d.meta.amount == officialDamage(receipt.cardId)
            && d.meta.source == receipt.cardId
          ) || (
            d.type == 'score_changed'
            && d.meta.scope == 'player'
            && d.seq == battleData(battleId).eventSeq + 4
            && d.meta.delta == receipt.playerDelta
            && d.meta.delta == officialPlayerDelta(receipt.cardId)
            && d.meta.delta >= 0
            && d.meta.score == receipt.playerScoreAfter
            && d.meta.cardId == receipt.cardId
          ) || (
            d.type == 'score_changed'
            && d.meta.scope == 'alliance'
            && d.seq == battleData(battleId).eventSeq + 5
            && d.meta.delta == receipt.allianceDelta + receipt.taken
            && d.meta.delta >= 0
            && d.meta.score == receipt.ownAllianceAfter
            && d.meta.cardId == receipt.cardId
          ) || (
            d.type == 'score_changed'
            && d.meta.scope == 'alliance'
            && d.seq == battleData(battleId).eventSeq + 6
            && d.meta.delta == 0 - receipt.taken
            && d.meta.score == receipt.oppAllianceAfter
            && d.meta.cardId == receipt.cardId
          )
        );
    }

    function isValidScoreInit(battleId, playerId) {
      let d = request.resource.data;
      let b = getAfter(/databases/$(database)/documents/battles/$(battleId)).data;
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && b.status in ['open', 'joining', 'locked']
        && d.battleId == battleId
        && d.playerId == playerId
        && d.score == 0
        && d.maxScore == 1000000
        && d.lastRequestId == null
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.keys().hasOnly([
          'battleId', 'playerId', 'score', 'maxScore', 'lastRequestId',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && playerId in b.participantIds;
    }

    function isValidScoreCreateOnPlay(battleId, playerId) {
      let d = request.resource.data;
      let receipt = energyReceipt(battleId, d.lastRequestId);
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && battleData(battleId).status == 'active'
        && playerId in battleData(battleId).participantIds
        && d.battleId == battleId
        && d.playerId == playerId
        && d.lastRequestId is string
        && receipt.playerId == playerId
        && receipt.requestId == d.lastRequestId
        && receipt.playerDelta == officialPlayerDelta(receipt.cardId)
        && d.score == receipt.playerDelta
        && d.score == receipt.playerScoreAfter
        && d.score >= 0
        && d.score <= 1000000
        && d.maxScore == 1000000
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.keys().hasOnly([
          'battleId', 'playerId', 'score', 'maxScore', 'lastRequestId',
          'schemaVersion', 'createdAt', 'updatedAt'
        ]);
    }

    function isValidScoreAward(battleId, playerId) {
      let before = resource.data;
      let after = request.resource.data;
      let reqId = after.lastRequestId;
      let receipt = energyReceipt(battleId, reqId);
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && battleData(battleId).status == 'active'
        && reqId is string
        && receipt.playerId == playerId
        && receipt.requestId == reqId
        && receipt.playerDelta == officialPlayerDelta(receipt.cardId)
        && receipt.playerDelta >= 0
        && receipt.playerDelta <= 10
        && before.score is int
        && after.score is int
        && after.score == before.score + receipt.playerDelta
        && after.score == receipt.playerScoreAfter
        && after.score >= 0
        && after.score <= 1000000
        && after.score >= before.score
        && after.maxScore == 1000000
        && after.diff(before).affectedKeys().hasOnly(['score', 'lastRequestId', 'updatedAt'])
        && after.updatedAt == request.time;
    }

    function isValidCardCostCreate(cardId) {
      let d = request.resource.data;
      return request.auth != null
        && officialCardCost(cardId) > 0
        && d.cardId == cardId
        && d.energyCost == officialCardCost(cardId)
        && d.energyCost is int
        && d.schemaVersion == 1
        && (
          d.keys().hasOnly(['cardId', 'energyCost', 'schemaVersion', 'updatedAt'])
          || (
            d.keys().hasOnly(['cardId', 'energyCost', 'cooldownMs', 'schemaVersion', 'updatedAt'])
            && d.cooldownMs == officialCardCooldownSec(cardId) * 1000
          )
        );
    }

    function isValidLoadoutFreeze(battleId) {
      let b = battleData(battleId);
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && b.status in ['active', 'finished']
        && request.resource.data.locked == true
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          request.auth.uid in b.attackerUids
          || request.auth.uid in b.defenderUids
        );
    }

    match /battles/{battleId} {
      allow read: if true;
      allow create: if isValidOpenBattleCreate() || isValidMapBattleCreate();
      allow update: if isValidLegacySeqBump() || isValidMapBattleJoin() || isValidMapBattleLock()
        || isValidBattleActivate() || isValidCardPlaySeqBump(battleId) || isValidTurnTimeout();
      allow delete: if false;

      match /events/{eventId} {
        allow read: if true;
        allow create: if isValidBattleEventCreate(battleId, eventId)
          || isValidBattleCreatedEvent(battleId, eventId)
          || isValidPlayerJoinedEvent(battleId, eventId)
          || isValidLoadoutLockedEvent(battleId, eventId)
          || isValidBattleFinishedEvent(battleId, eventId)
          || isValidTurnStartedEvent(battleId, eventId)
          || isValidEnergyPlayEvent(battleId, eventId)
          || isValidScorePlayEvent(battleId, eventId)
          || isValidTurnTimeoutEvent(battleId, eventId);
        allow update, delete: if false;
      }

      match /energy/{playerId} {
        allow read: if true;
        allow create: if isValidEnergyInit(battleId, playerId);
        allow update: if isValidEnergySpend(battleId, playerId);
        allow delete: if false;
      }

      match /energy_requests/{requestId} {
        allow read: if true;
        allow create: if isValidEnergyRequestCreate(battleId, requestId);
        allow update, delete: if false;
      }

      match /scores/{playerId} {
        allow read: if true;
        allow create: if isValidScoreInit(battleId, playerId)
          || isValidScoreCreateOnPlay(battleId, playerId);
        allow update: if isValidScoreAward(battleId, playerId);
        allow delete: if false;
      }

      match /loadouts/{playerId} {
        allow read: if isLoadoutTeamRead(battleId);
        allow create: if isValidLoadoutWrite(battleId, playerId, true);
        allow update: if isValidLoadoutWrite(battleId, playerId, false)
          || isValidLoadoutFreeze(battleId);
        allow delete: if false;
      }
    }

    match /battle_card_costs/{cardId} {
      allow read: if true;
      allow create: if isValidCardCostCreate(cardId);
      allow update, delete: if false;
    }

    match /server_clock/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'updatedAt'])
        && request.resource.data.t == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /alliance_battle_cooldowns/{allianceId} {
      allow read: if true;
      allow create: if isValidCooldownWrite(allianceId);
      allow update: if isValidCooldownWrite(allianceId)
        && request.time >= resource.data.cooldownUntil;
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if !isProtectedPath(document);
      allow write: if !isProtectedPath(document);
    }
  }
}
