        && d.targetAllianceId == receipt.targetAllianceId
        && d.requiredClicks == receipt.clickRequired
        && d.requiredClicks == officialChallengeClicks(d.cardId, d.targetAllianceId)
        && d.requiredClicks > 0
        && d.requiredClicks <= 14
        && d.currentClicks == 0
        && d.status == 'active'
        && d.startedAt == request.time
        && d.durationMs == 15000
        && d.schemaVersion == 1
        && d.createdBy is string
        && d.keys().hasOnly([
          'challengeId', 'battleId', 'cardId', 'requestId', 'targetAllianceId',
          'requiredClicks', 'currentClicks', 'startedAt', 'durationMs',
          'status', 'createdBy', 'schemaVersion'
        ]);
    }

    function isValidChallengeClick(battleId, challengeId) {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.status == 'active'
        && request.time < before.startedAt + duration.value(15, 's')
        && after.requiredClicks == before.requiredClicks
        && after.targetAllianceId == before.targetAllianceId
        && after.cardId == before.cardId
        && after.currentClicks == before.currentClicks + 1
        && after.currentClicks <= before.requiredClicks
        && after.currentClicks > 0
        && (
          after.currentClicks < after.requiredClicks
            ? after.status == 'active'
            : after.status == 'succeeded'
        )
        && !exists(/databases/$(database)/documents/battles/$(battleId)/challenges/$(challengeId)/clicks/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(challengeId)/clicks/$(request.auth.uid))
        && exists(/databases/$(database)/documents/alliances/$(before.targetAllianceId))
        && (
          getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(challengeId)/clicks/$(request.auth.uid)).data.playerId
            in get(/databases/$(database)/documents/alliances/$(before.targetAllianceId)).data.members
          || get(/databases/$(database)/documents/alliances/$(before.targetAllianceId)).data.leaderId
            == getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(challengeId)/clicks/$(request.auth.uid)).data.playerId
        )
        && after.diff(before).affectedKeys().hasOnly(['currentClicks', 'status', 'updatedAt']);
    }

    function isValidChallengeExpire(battleId, challengeId) {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.status == 'active'
        && request.time >= before.startedAt + duration.value(15, 's')
        && after.status == 'expired'
        && after.currentClicks == before.currentClicks
        && after.requiredClicks == before.requiredClicks
        && after.targetAllianceId == before.targetAllianceId
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isValidChallengeCloseOnFinish(battleId, challengeId) {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && before.status == 'active'
        && existsAfter(/databases/$(database)/documents/battles/$(battleId))
        && battleAfter(battleId).status == 'finished'
        && after.status == 'expired'
        && after.currentClicks == before.currentClicks
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isValidChallengeClickCreate(battleId, challengeId, clickId) {
      let d = request.resource.data;
      let ch = challengeData(battleId, challengeId);
      return request.auth != null
        && clickId == request.auth.uid
        && exists(/databases/$(database)/documents/battles/$(battleId)/challenges/$(challengeId))
        && ch.status == 'active'
        && request.time < ch.startedAt + duration.value(15, 's')
        && d.uid == request.auth.uid
        && d.playerId is string
        && d.createdAt == request.time
        && d.schemaVersion == 1
        && exists(/databases/$(database)/documents/alliances/$(ch.targetAllianceId))
        && (
          d.playerId in get(/databases/$(database)/documents/alliances/$(ch.targetAllianceId)).data.members
          || get(/databases/$(database)/documents/alliances/$(ch.targetAllianceId)).data.leaderId == d.playerId
        )
        && getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(challengeId)).data.currentClicks
          == ch.currentClicks + 1;
    }

    function canReadBattle(battleId) {
      return exists(/databases/$(database)/documents/battles/$(battleId))
        && request.auth != null
        && (
          battleData(battleId).status == 'joining'
          || (
            battleData(battleId).keys().hasAny(['attackerUids'])
            && request.auth.uid in battleData(battleId).attackerUids
          )
          || (
            battleData(battleId).keys().hasAny(['defenderUids'])
            && request.auth.uid in battleData(battleId).defenderUids
          )
        );
    }

    function isValidClickCompleteEvent(battleId, eventId) {
      let d = request.resource.data;
      let cid = d.meta.requestId;
      return request.auth != null
        && isBattleEventDoc(battleId, eventId)
        && d.type == 'click_completed'
        && isNextEventSeq(battleId)
        && cid is string
        && existsAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(cid))
        && d.meta.clicks is int
        && d.meta.required is int
        && d.meta.success is bool
        && d.meta.required > 0
        && d.meta.required <= 14
        && d.meta.clicks >= 0
        && d.meta.clicks <= d.meta.required
        && d.meta.clicks == getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(cid)).data.currentClicks
        && d.meta.required == getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(cid)).data.requiredClicks
        && (
          (d.meta.success == true && d.meta.clicks == d.meta.required
            && getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(cid)).data.status == 'succeeded')
          || (d.meta.success == false && d.meta.clicks < d.meta.required
            && getAfter(/databases/$(database)/documents/battles/$(battleId)/challenges/$(cid)).data.status == 'expired')
        );
    }

    function isValidLoadoutFreeze(battleId) {
      let b = battleData(battleId);
      return request.auth != null
        && exists(/databases/$(database)/documents/battles/$(battleId))
        && b.status in ['active', 'finished']
        && request.resource.data.locked == true
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          request.auth.uid in b.attackerUids
          || request.auth.uid in b.defenderUids
        );
    }

    match /battles/{battleId} {
      allow read: if request.auth != null
        && (
          resource.data.status == 'joining'
          || (resource.data.keys().hasAny(['attackerUids']) && request.auth.uid in resource.data.attackerUids)
          || (resource.data.keys().hasAny(['defenderUids']) && request.auth.uid in resource.data.defenderUids)
        );
      allow create: if isValidOpenBattleCreate() || isValidMapBattleCreate();
      allow update: if isValidLegacySeqBump() || isValidMapBattleJoin() || isValidMapBattleLock()
        || isValidBattleActivate() || isValidCardPlaySeqBump(battleId) || isValidTurnTimeout()
        || isValidBattleFinish();
      allow delete: if false;

      match /events/{eventId} {
        allow read: if canReadBattle(battleId);
        allow create: if isValidBattleEventCreate(battleId, eventId)
          || isValidBattleCreatedEvent(battleId, eventId)
          || isValidPlayerJoinedEvent(battleId, eventId)
          || isValidLoadoutLockedEvent(battleId, eventId)
          || isValidBattleFinishedEvent(battleId, eventId)
          || isValidTurnStartedEvent(battleId, eventId)
          || isValidEnergyPlayEvent(battleId, eventId)
          || isValidScorePlayEvent(battleId, eventId)
          || isValidTurnTimeoutEvent(battleId, eventId)
          || isValidClickCompleteEvent(battleId, eventId);
        allow update, delete: if false;
      }

      match /energy/{playerId} {
        allow read: if canReadBattle(battleId);
        allow create: if isValidEnergyInit(battleId, playerId);
        allow update: if isValidEnergySpend(battleId, playerId);
        allow delete: if false;
      }

      match /energy_requests/{requestId} {
        allow read: if canReadBattle(battleId);
        allow create: if isValidEnergyRequestCreate(battleId, requestId);
        allow update, delete: if false;
      }

      match /scores/{playerId} {
        allow read: if canReadBattle(battleId);
        allow create: if isValidScoreInit(battleId, playerId)
          || isValidScoreCreateOnPlay(battleId, playerId);
        allow update: if isValidScoreAward(battleId, playerId);
        allow delete: if false;
      }

      match /challenges/{challengeId} {
        allow read: if request.auth != null
          && (
            canReadBattle(battleId)
            || (
              resource.data.keys().hasAny(['targetAllianceId'])
              && isAllianceMemberOrLeader(resource.data.targetAllianceId, request.auth.uid)
            )
          );
        allow create: if isValidChallengeCreate(battleId, challengeId);
        allow update: if isValidChallengeClick(battleId, challengeId)
          || isValidChallengeExpire(battleId, challengeId)
          || isValidChallengeCloseOnFinish(battleId, challengeId);
        allow delete: if false;

        match /clicks/{clickId} {
          allow read: if canReadBattle(battleId);
          allow create: if isValidChallengeClickCreate(battleId, challengeId, clickId);
          allow update, delete: if false;
        }
      }

      match /result/{resultId} {
        allow read: if canReadBattle(battleId);
        allow create: if isValidBattleResultCreate(battleId, resultId);
        allow update, delete: if false;
      }

      match /loadouts/{playerId} {
        allow read: if isLoadoutTeamRead(battleId);
        allow create: if isValidLoadoutWrite(battleId, playerId, true);
        allow update: if isValidLoadoutWrite(battleId, playerId, false)
          || isValidLoadoutFreeze(battleId);
        allow delete: if false;
      }
    }

    match /battle_card_costs/{cardId} {
      allow read: if true;
      allow create: if isValidCardCostCreate(cardId);
      allow update, delete: if false;
    }

    match /server_clock/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'updatedAt'])
        && request.resource.data.t == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /alliance_battle_cooldowns/{allianceId} {
      allow read: if true;
      allow create: if isValidCooldownWrite(allianceId);
      allow update: if isValidCooldownWrite(allianceId)
        && request.time >= resource.data.cooldownUntil;
      allow delete: if false;
    }

    function isLeaderboardPeriodKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidLeaderboardBoard(kind) {
      let d = request.resource.data;
      return request.auth != null
        && d.kind == kind
        && d.timezone == 'Asia/Baku'
        && d.offsetMs == 14400000
        && d.status in ['open', 'closed']
        && d.rows is list
        && d.rows.size() <= 100
        && d.schemaVersion == 1
        && d.updatedAt == request.time;
    }

    match /leaderboard_state/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.timezone == 'Asia/Baku'
        && request.resource.data.offsetMs == 14400000
        && isLeaderboardPeriodKey(request.resource.data.openDayKey)
        && isLeaderboardPeriodKey(request.resource.data.openWeekKey);
      allow delete: if false;
    }

    match /leaderboard_resets/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.status == 'done'
        && request.resource.data.kind in ['daily', 'weekly']
        && isLeaderboardPeriodKey(request.resource.data.periodKey)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /leaderboard_archives/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.kind in ['daily', 'weekly']
        && isLeaderboardPeriodKey(request.resource.data.periodKey)
        && request.resource.data.rows is list
        && request.resource.data.archivedAt == request.time;
      allow update, delete: if false;
    }

    function leaderboardAwardFromBattle(battleId) {
      return exists(/databases/$(database)/documents/battles/$(battleId)/result/final)
        && get(/databases/$(database)/documents/battles/$(battleId)/result/final).data.status == 'finished'
        && existsAfter(/databases/$(database)/documents/leaderboard_awards/$(battleId));
    }

    match /leaderboard_daily/{dayKey} {
      allow read: if true;
      allow create: if isLeaderboardPeriodKey(dayKey)
        && request.resource.data.periodKey == dayKey
        && request.resource.data.version == 1
        && request.resource.data.rows.size() == 0
        && isValidLeaderboardBoard('daily');
      allow update: if isLeaderboardPeriodKey(dayKey)
        && request.resource.data.periodKey == dayKey
        && isValidLeaderboardBoard('daily')
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;

      match /entries/{playerId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.playerId == playerId
          && request.resource.data.dayKey == dayKey
          && request.resource.data.battleId is string
          && leaderboardAwardFromBattle(request.resource.data.battleId)
          && playerId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.participantIds
          && request.resource.data.score is int
          && playerId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.playerDeltas
          && request.resource.data.score == get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.playerDeltas[playerId]
          && request.resource.data.score >= 0
          && request.resource.data.score <= 8
          && request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null
          && request.resource.data.playerId == playerId
          && request.resource.data.dayKey == dayKey
          && request.resource.data.battleId is string
          && leaderboardAwardFromBattle(request.resource.data.battleId)
          && playerId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.participantIds
          && playerId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.playerDeltas
          && request.resource.data.score is int
          && request.resource.data.score == resource.data.score + get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.playerDeltas[playerId]
          && request.resource.data.score <= 1000000
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /leaderboard_weekly/{weekKey} {
      allow read: if true;
      allow create: if isLeaderboardPeriodKey(weekKey)
        && request.resource.data.periodKey == weekKey
        && request.resource.data.version == 1
        && isValidLeaderboardBoard('weekly');
      allow update: if isLeaderboardPeriodKey(weekKey)
        && request.resource.data.periodKey == weekKey
        && isValidLeaderboardBoard('weekly')
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;

      match /entries/{allianceId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.allianceId == allianceId
          && request.resource.data.weekKey == weekKey
          && request.resource.data.battleId is string
          && leaderboardAwardFromBattle(request.resource.data.battleId)
          && allianceId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.allianceDeltas
          && request.resource.data.rawScore is int
          && allianceId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.allianceDeltas
          && request.resource.data.rawScore == get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.allianceDeltas[allianceId]
          && request.resource.data.rawScore >= 0
          && request.resource.data.rawScore <= 6
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000
          && request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null
          && request.resource.data.allianceId == allianceId
          && request.resource.data.weekKey == weekKey
          && request.resource.data.battleId is string
          && leaderboardAwardFromBattle(request.resource.data.battleId)
          && allianceId in get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.allianceDeltas
          && request.resource.data.rawScore is int
          && request.resource.data.rawScore == resource.data.rawScore + get(/databases/$(database)/documents/battles/$(request.resource.data.battleId)/result/final).data.allianceDeltas[allianceId]
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /leaderboard_awards/{battleId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.battleId == battleId
        && request.resource.data.status == 'done'
        && isLeaderboardPeriodKey(request.resource.data.dayKey)
        && isLeaderboardPeriodKey(request.resource.data.weekKey)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/battles/$(battleId)/result/final)
        && get(/databases/$(database)/documents/battles/$(battleId)/result/final).data.status == 'finished';
      allow update, delete: if false;
    }

    function finishedResult(battleId) {
      return get(/databases/$(database)/documents/battles/$(battleId)/result/final).data;
    }

    function isValidPlayerFinishScore(playerId) {
      let before = resource.data;
      let after = request.resource.data;
      let battleId = after.lastScoreBattleId;
      let delta = finishedResult(battleId).playerDeltas[playerId];
      return battleId is string
        && exists(/databases/$(database)/documents/battles/$(battleId)/result/final)
        && finishedResult(battleId).status == 'finished'
        && finishedResult(battleId).reason in ['score_reached', 'turn_limit']
        && playerId in finishedResult(battleId).playerDeltas
        && delta is int
        && delta >= 0
        && delta <= 8
        && after.lastScoreBattleId != (before.keys().hasAny(['lastScoreBattleId']) ? before.lastScoreBattleId : '')
        && after.score is int
        && (
          (before.keys().hasAny(['score']) && before.score is int && after.score == before.score + delta)
          || (!before.keys().hasAny(['score']) && after.score == delta)
        )
        && after.dailyScore is int
        && after.dailyScore >= 0
        && after.dailyScore <= 1000000
        && (
          after.dailyScore == delta
          || (
            before.keys().hasAny(['dailyScore'])
            && before.dailyScore is int
            && after.dailyScore == before.dailyScore + delta
          )
        );
    }

    function isValidAllianceFinishScore(allianceId) {
      let before = resource.data;
      let after = request.resource.data;
      let battleId = after.lastScoreBattleId;
      let delta = finishedResult(battleId).allianceDeltas[allianceId];
      let lifeBase = before.keys().hasAny(['lifetimeScore']) && before.lifetimeScore is int
        ? before.lifetimeScore
        : (before.keys().hasAny(['score']) && before.score is int ? before.score : 0);
      return battleId is string
        && exists(/databases/$(database)/documents/battles/$(battleId)/result/final)
        && finishedResult(battleId).status == 'finished'
        && finishedResult(battleId).reason in ['score_reached', 'turn_limit']
        && allianceId in finishedResult(battleId).allianceDeltas
        && delta is int
        && delta > 0
        && delta <= 6
        && after.lastScoreBattleId != (before.keys().hasAny(['lastScoreBattleId']) ? before.lastScoreBattleId : '')
        && after.score is int
        && (
          (before.keys().hasAny(['score']) && before.score is int && after.score == before.score + delta)
          || after.score == 50 + delta
        )
        && after.lifetimeScore is int
        && after.lifetimeScore == lifeBase + delta;
    }

    function isValidAllianceWeeklyReset() {
      let after = request.resource.data;
      return after.score == 50
        && after.weeklyKey is string
        && after.weeklyResetFrom is string
        && after.weeklyKey != after.weeklyResetFrom
        && existsAfter(/databases/$(database)/documents/leaderboard_resets/weekly_$(after.weeklyResetFrom));
    }

    match /alliances/{allianceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'lifetimeScore'])
          || isValidAllianceFinishScore(allianceId)
          || isValidAllianceWeeklyReset()
        );
      allow delete: if false;
    }

    function currentUserPlan(d) {
      return d.keys().hasAny(['userPlan']) && d.userPlan in ['FREE', 'PRO', 'VIP_PRO']
        ? d.userPlan
        : 'FREE';
    }

    function isValidVipProPurchase() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeManat = before.keys().hasAny(['manat']) && before.manat is int ? before.manat : 0;
      return currentUserPlan(before) != 'VIP_PRO'
        && after.userPlan == 'VIP_PRO'
        && after.hasVipPass == true
        && after.isVipLifetime == true
        && after.proPanelActive == true
        && after.manat is int
        && after.manat == beforeManat - 30
        && after.manat >= 0
        && after.coins == after.manat;
    }

    function isValidProPanelToggle() {
      let before = resource.data;
      let after = request.resource.data;
      return after.proPanelActive is bool
        && after.manat == before.manat
        && currentUserPlan(after) == currentUserPlan(before)
        && after.diff(before).affectedKeys().hasOnly(['proPanelActive', 'updatedAt']);
    }

    function isValidPlanWrite() {
      return isValidVipProPurchase() || isValidProPanelToggle();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'dailyScore', 'lifetimeScore'])
          || isValidPlayerFinishScore(playerId)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userPlan', 'hasVipPass', 'isVipLifetime', 'proPanelActive'])
          || isValidPlanWrite()
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if !isProtectedPath(document);
      allow write: if !isProtectedPath(document);
    }
  }
}
