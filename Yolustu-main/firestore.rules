        && d.energy == 25
        && d.maxEnergy == 25
        && d.cardUsage is map
        && d.cardUsage.size() == 0
        && d.cardCooldownUntil is map
        && d.cardCooldownUntil.size() == 0
        && d.lastRequestId == null
        && d.schemaVersion == 1
