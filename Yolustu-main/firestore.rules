        && request.time >= before.turnStartAt + duration.value(15, 's')
        && after.status == 'active'
        && after.eventSeq == before.eventSeq + 1
        && after.stateVersion == before.stateVersion + 1
        && after.turnStartAt == request.time
        && after.turnDurationMs == 15000
        && after.turn is int
        && after.turnSide in ['attacker', 'defender']
        && after.turnPlayerId is string
